,"size":"40px"},{"name":"5","size":"3rem"},{"name":"6","size":"3.5rem"},{"name":"7","size":"4rem"},{"name":"8","size":"4.5rem"},{"name":"9","size":"5rem"},{"name":"10","size":"6rem"},{"name":"11","size":"7rem"},{"name":"12","size":"8rem"},{"name":"[10px]","size":"10px"},{"name":"[12px]","size":"12px"},{"name":"[14px]","size":"14px"},{"name":"[18px]","size":"18px"}],"typography":{"heading_font":{"family":"Inter Tight"},"body":{"family":"Fraunces","variation":"regular","color":"#ffffff","size":{"value":"16","unit":"px"},"line-height":"2"},"h1":{"family":"Fraunces","variation":"regular","color":"","size":{"value":"138","unit":"px"},"line-height":"0.82","letter-spacing":"-11.01"},"h2":{"family":"Fraunces","variation":"regular","color":"","size":{"value":"82","unit":"px"},"line-height":"0.88","letter-spacing":"-5.75"},"h3":{"family":"Fraunces","variation":"regular","color":"","size":{"value":"46","unit":"px"},"line-height":"0.94","letter-spacing":"-2.3"}},"animation_preloader":{"enable":"yes"},"preloader_style":{"style":"custom","custom":{"html":"<div class=\"splash-shell\">\n                        <video id=\"heroVideo\" autoplay=\"\" muted=\"\" loop=\"\" playsinline=\"\" class=\"object-center w-full h-full object-cover [-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_15%,black_70%,transparent_90%)] [mask-image:linear-gradient(to_right,transparent_0%,black_15%,black_70%,transparent_90%)]\" style=\"transform: scale(1.06) translateY(0px);\">\n                            <source src=\"https:\/\/videos.openhero.art\/downloads\/enterprice\/the-art-of-the-burger\/video.mp4\" type=\"video\/mp4\">\n                        <\/source><\/video>\n                        <div class=\"sauce-glow\"><\/div>\n                    <\/div>","css":".splash-shell{\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n\n            width: 120%;\n            height: 110%;\n\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n.splash-shell video{\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n            object-position: center;\n        }\n.sauce-glow{\n            position: absolute;\n            inset: 0;\n            background:\n                radial-gradient(circle at 18% 26%, rgba(0, 0, 0, 0.28), transparent 18%),\n                radial-gradient(circle at 52% 24%, rgba(255, 228, 195, .12), transparent 16%),\n                radial-gradient(circle at 70% 62%, rgba(110, 208, 76, .16), transparent 16%),\n                linear-gradient(180deg, rgba(0, 37, 32, 0.08), rgba(0, 0, 0, .4));\n            pointer-events: none;\n        }\n.h-full{height:100%}\n.w-full{width:100%}\n.object-cover{object-fit:cover}\n.object-center{object-position:center}","js":"const heroVideo = document.getElementById('heroVideo');\n        const supportsViewTransitions = typeof document.startViewTransition === 'function';\n        let ticking = false;\n\n        function updateHero() {\n            const max = window.innerHeight * 1.15;\n            const progress = Math.min(Math.max(window.scrollY \/ max, 0), 1);\n            const scale = 1.06 + progress * 0.18;\n            const translate = progress * 18;\n            if (heroVideo) {\n                heroVideo.style.transform = `scale(${scale}) translateY(${translate}px)`;\n            }\n        }\n\n        updateHero();\n\n        window.addEventListener('scroll', () => {\n            if (ticking) return;\n            ticking = true;\n            requestAnimationFrame(() => {\n                updateHero();\n                ticking = false;\n            });\n        }, { passive: true });\n\n        const revealObserver = new IntersectionObserver((entries) => {\n            entries.forEach((entry) => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('in');\n                }\n            });\n        }, { threshold: 0.16 });\n\n        document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));\n\n        const assembleObserver = new IntersectionObserver((entries) => {\n            entries.forEach((entry) => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('in');\n                }\n            });\n        }, { threshold: 0.14 });\n\n        document.querySelectorAll('.layer').forEach((el) => assembleObserver.observe(el));\n\n        document.querySelectorAll('a, button').forEach((el) => {\n            el.addEventListener('mouseenter', () => {\n                el.animate(\n                    [{ transform: 'translateY(0px)' }, { transform: 'translateY(-2px)' }],\n                    { duration: 220, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'forwards' }\n                );\n            });\n\n            el.addEventListener('mouseleave', () => {\n                el.animate(\n                    [{ transform: 'translateY(-2px)' }, { transform: 'translateY(0px)' }],\n                    { duration: 220, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'forwards' }\n                );\n            });\n        });\n\n        if (supportsViewTransitions) {\n            document.querySelectorAll('button').forEach((button) => {\n                button.addEventListener('click', () => {\n                    document.startViewTransition(() => { });\n                });\n            });\n        }"}}}}