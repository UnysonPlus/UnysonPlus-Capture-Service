# Dependencies (regenerate with `npm install`)
node_modules/

# Capture / build output
capture-out/
**/capture-out/
# ...and every sibling the runs produce (capture-out-full, -missing, -cl, -wegicW*, batch).
# Only `capture-out/` was listed, so a sync into this push-only clone dragged in 600+ MB of
# capture artefacts and GitHub rejected the push over a 155 MB bundle zip.
capture-out*/
**/capture-out*/
batch/
**/batch/
logs/
**/logs/
*.log

# Local report-sharing config (Google Form ids) — never committed; copy from share-config.example.json
share-config.json
**/share-config.json

# Maintainer-side report aggregation (local state + generated output + downloaded responses)
.reports-watermark.json
**/.reports-watermark.json
reports-todo.md
**/reports-todo.md
responses*.csv

# OS / editor cruft
.DS_Store
Thumbs.db

# local corpus/run artifacts (never in the clone)
batch/
**/batch/
.share-last-send
_active.json
_ai.json
*.local.txt

# Local AI endpoint config — CONTAINS AN API KEY. Never commit.
ai-endpoint.json
**/ai-endpoint.json

# Ad-hoc scratch scripts and URL lists from capture runs. They name the real
# source sites that were captured, so they must never reach the repo.
_*.txt
**/_*.txt
_bc*.mjs
**/_bc*.mjs
_check.mjs
_final.mjs
_run-verify.mjs
**/_check.mjs
**/_final.mjs
**/_run-verify.mjs

# Local triage state for findings (maintainer-side, regenerable)
triage-ledger.json
**/triage-ledger.json
